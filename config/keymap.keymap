#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE        &kp Q         &kp W             &kp E     &kp R     &kp T      &kp Y             &kp U             &kp I  &kp O           &kp P           &kp BSPC
&kp TAB           &kp A         &kp S             &kp D     &kp F     &kp G      &kp H             &kp J             &kp K  &kp L           &kp MINUS       &kp ENTER
&kp LSHFT         &kp Z         &kp X             &kp C     &kp V     &kp B      &kp LBKT          &kp RBKT          &kp N  &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &mt RSHFT QUESTION
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp SEMI  &kp APOS  &kp SPACE  &lt 2 LANGUAGE_2  &lt 3 LANGUAGE_1  &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none      &none      &none      &none  &none
&none  &none  &none  &none  &none  &none  &none  &mkp LCLK  &mkp MCLK  &mkp RCLK  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none      &none      &none      &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none      &none      &none      &none  &none
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE        &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSPACE
&kp TAB           &none            &none        &none     &none       &none        &kp EQUAL  &kp PLUS       &kp BACKSLASH  &kp PIPE              &kp GRAVE              &kp TILDE
&kp LEFT_SHIFT    &none            &none        &none     &none       &none        &none      &none          &none          &none                 &none                  &none          &none  &none
&kp LEFT_CONTROL  &none            &none        &none     &none       &none        &none      &none          &none          &none                 &none                  &none
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE        &kp N1  &kp N2   &kp N3     &kp N4        &kp N5     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BACKSPACE
&kp TAB           &kp N4  &kp N5   &kp N6     &kp PLUS      &kp MINUS  &none   &none   &none   &none   &none   &none
&kp LEFT_SHIFT    &kp N7  &kp N8   &kp N9     &kp ASTERISK  &kp SLASH  &none   &none   &none   &none   &none   &none          &none  &none
&kp LEFT_CONTROL  &kp N0  &kp DOT  &kp EQUAL  &none         &none      &none   &none   &none   &none   &none   &none
            >;
        };

        layer_4 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
